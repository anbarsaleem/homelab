global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['127.0.0.1:9090']

  - job_name: 'node'
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ hostvars[host]["ansible_host"] | default(host) }}:9100']
        labels:
          instance: '{{ host }}'
{% endfor %}

  - job_name: 'jobscout'
    static_configs:
{% if 'jobscout' in hostvars %}
      - targets: ['{{ hostvars["jobscout"]["ansible_host"] | default("jobscout") }}:{{ jobscout_metrics_port }}']
        labels:
          instance: 'jobscout'
{% else %}
      [] # jobscout container not yet in inventory
{% endif %}
